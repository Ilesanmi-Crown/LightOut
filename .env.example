# Copy to .env.local and fill in from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required: Firebase AI Logic rejects requests without it)
VITE_RECAPTCHA_SITE_KEY=
# Optional: a debug token registered in Firebase Console > App Check > Manage debug tokens.
# If empty, dev mode prints a new one to the browser console.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud model
VITE_CLOUD_MODEL=gemini-3.8-flash
